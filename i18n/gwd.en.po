msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"

msgid "GAME_TITLE"
msgstr "GAMBLING WITH THE DEVIL"

msgid "BLINDS_LBL"
msgstr "Blinds"

msgid "HINT_CARD"
msgstr "Hover a card to inspect"

msgid "ROUND"
msgstr "Round"

msgid "BLIND"
msgstr "Blind"

msgid "BLOOD"
msgstr "blood"

msgid "CARDS_LEFT"
msgstr "deck"

msgid "CHIPS_YOU"
msgstr "YOU"

msgid "CHIPS_DEVIL"
msgstr "DEVIL"

msgid "HINT_PLACE"
msgstr "Place cards concealed — right-click sacrifices for blood — B raises the stakes — SPACE reveals"

msgid "HINT_PAD"
msgstr "Pick a lane pad — front rank strikes, back rank shelters"

msgid "HINT_NOBLOOD"
msgstr "Not enough blood — sacrifice a card (right-click)"

msgid "HINT_PLACE_MORE"
msgstr "Place more or press SPACE to reveal"

msgid "SACRIFICED"
msgstr "Sacrificed:"

msgid "PHASE_RESOLVING"
msgstr "The table decides..."

msgid "BTN_REVEAL"
msgstr "REVEAL ▸"

msgid "GAME_OVER"
msgstr "The hand is played"

msgid "YOU_WIN"
msgstr "YOU OWN THE TABLE"

msgid "DEVIL_WINS"
msgstr "THE DEVIL COLLECTS"

msgid "RESTART"
msgstr "(R — deal again)"

# --- cards ---------------------------------------------------------------
msgid "CARD_CUTPURSE"
msgstr "Cutpurse"

msgid "CARD_DUELIST"
msgstr "Duelist"

msgid "CARD_REAPER"
msgstr "Reaper"

msgid "CARD_WARDEN"
msgstr "Warden"

msgid "CARD_VOTARY"
msgstr "Votary"

msgid "CARD_MARTYR"
msgstr "Martyr"

msgid "CARD_ACOLYTE"
msgstr "Acolyte"

msgid "CARD_USURER"
msgstr "Usurer"

msgid "CARD_SPY"
msgstr "Spy"

msgid "CARD_SEER"
msgstr "Seer"

msgid "POT"
msgstr "pot"

msgid "EMBERS_WON"
msgstr "embers claimed"

msgid "DEBT_LBL"
msgstr "debt"

msgid "RAISED"
msgstr "You raise — the Devil notices."

msgid "WAGER_OFFER"
msgstr "AZRAIL: \"Out of souls? I'll stake you — ten chips. The price is fifteen, owed.\"\n(Y — take his deal   ·   N — end it)"

msgid "AZRAIL_CRUELTY"
msgstr "Azrail purrs — he can smell desperation."

msgid "AZRAIL_CURIOSITY"
msgstr "Azrail tilts his head. \"Interesting.\""

msgid "AZRAIL_ANGER"
msgstr "Azrail's knuckles whiten on the armrests. \"Enough.\""

msgid "AZRAIL_RESPECT"
msgstr "Azrail inclines his head a degree. A worthy opponent."

msgid "AZRAIL_BOREDOM"
msgstr "Azrail taps the felt. \"You stall — I grow bored. The blinds do not.\""

msgid "HINT_CALL"
msgstr "Call the Bluff — click one of his concealed cards (2 chips)"

msgid "HINT_NOCALL"
msgstr "No Call left this battle"

msgid "CALL_BLUFF"
msgstr "A LIE — the counterfeit burns. Azrail pays 2 chips."

msgid "CALL_REAL"
msgstr "Real. You bought the truth for 2 chips."

msgid "CARD_BLUFF"
msgstr "Palmed"

msgid "HINT_PLACE_R1"
msgstr "Place cards concealed — right-click sacrifices — B raises — M mulligan — SPACE reveals"

msgid "MULLIGAN"
msgstr "Azrail takes the cards back and redeals — a fresh hand."

msgid "HINT_NOMULL"
msgstr "No mulligan left in this battle"

msgid "INTRO_SUB"
msgstr "You took his seat. The wager is your soul."
msgid "HINT_REPOS"
msgstr "Choose a lane — the card moves once this battle."

msgid "HINT_REPOS_DOWN"
msgstr "Concealed cards can't reposition."

msgid "HINT_NOREPOS"
msgstr "That card already moved."

msgid "REPOS_DONE"
msgstr "%s slips to a new lane."

msgid "REPOS_SWAP"
msgstr "The pawns trade lanes."

msgid "HINT_TRICK_TARGET"
msgstr "Choose one of your revealed pawns."

msgid "TRICK_USURER"
msgstr "+4 chips — the debt grows by 2."

msgid "TRICK_TITHE_NONE"
msgstr "No dead pawn to dig up."

msgid "TRICK_TITHE"
msgstr "The grave gives back %s."

msgid "TRICK_RAZOR"
msgstr "Sharp edge — %s strikes first in its lane."

msgid "CARD_USURER_T"
msgstr "Pale Usurer"

msgid "CARD_TITHE"
msgstr "Gravedigger's Tithe"

msgid "CARD_RAZOR"
msgstr "Straight Razor"
msgid "TRUMPS_LBL"
msgstr "TRUMPS"

msgid "TRUMP_SLEEVE_ACE"
msgstr "Sleeve Ace"

msgid "TRUMP_COLD_DECK"
msgstr "Cold Deck"

msgid "TRUMP_MARKED_CARDS"
msgstr "Marked Cards"

msgid "TRUMPS_EMPTY"
msgstr "No trump left up that sleeve."

msgid "TRUMP_NOPEEK"
msgstr "Nothing concealed to peek at."

msgid "TRUMP_PEEKED"
msgstr "A glance — his hidden cards turn over for a breath."

msgid "TRUMP_COLD"
msgstr "Cold deck — he takes your hand back and redeals."

msgid "TRUMP_MARKED"
msgstr "Marked cards — your tells are invisible this battle."
msgid "EFFIGY_LBL"
msgstr "MANTEL"

msgid "EFFIGY_BELL"
msgstr "Debtor's Bell"

msgid "EFFIGY_CROUPIER"
msgstr "Croupier's Left Hand"
msgid "TRUMP_LOADED_DICE"
msgstr "Loaded Dice"

msgid "TRUMP_MIRRORED_COIN"
msgstr "Mirrored Coin"

msgid "TRUMP_LOADED"
msgstr "Loaded dice — your next roll can't lose."

msgid "TRUMP_MIRRORED"
msgstr "Mirrored coin — one lost roll comes back."

msgid "COIN_REROLL"
msgstr "The mirrored coin flips the roll again."

msgid "PRIESTESS_WON"
msgstr "The Priestess smiles — heads: +3 chips."

msgid "PRIESTESS_LOST"
msgstr "The Priestess frowns — tails: −1 chip."

msgid "CARD_PRIESTESS"
msgstr "High Priestess of Chance"


msgid "DEPTH"
msgstr "Descent"

msgid "HINT_EVENT"
msgstr "The table opens three doors — pick your descent."

msgid "CARD_EVENT_WHISPER"
msgstr "The Whisper"

msgid "CARD_EVENT_WHEEL"
msgstr "The Wheel"

msgid "CARD_EVENT_COVENANT"
msgstr "The Covenant"

msgid "EV_WHISPER_WIN"
msgstr "He whispers a cheat in your ear — your luck sharpens."

msgid "EV_WHISPER_LOSE"
msgstr "The whisper was a hook — you owe him 6 more."

msgid "EV_WHEEL_WIN"
msgstr "The wheel stops on gold — +12 souls ride with you."

msgid "EV_WHEEL_LOSE"
msgstr "The wheel lands on him — 10 more souls owed."

msgid "EV_COVENANT"
msgstr "A signed passage — +5 souls, a small blessing."

msgid "PRIESTESS_DEVIL"
msgstr "His Priestess flips — the House collects, or bleeds."

msgid "EMBERS_LBL"
msgstr "Embers"

msgid "EMBER_SPENT"
msgstr "Fifteen embers burn one of his counterfeits out of the next deck."

msgid "HINT_EMBER"
msgstr "— or press E: 15 embers burn one of his counterfeits."

msgid "CARD_EVENT_LEDGER"
msgstr "The Ledger"

msgid "CARD_EVENT_MIRROR"
msgstr "The Mirror"

msgid "EV_LEDGER"
msgstr "The Usurer strikes five debts — for four souls up front."

msgid "EV_MIRROR"
msgstr "The mirror shows your luck backwards — it is flipped."

msgid "CARD_EVENT_WHISPER_DESC"
msgstr "a gamble: sharper luck, or six souls owed"

msgid "CARD_EVENT_WHEEL_DESC"
msgstr "a big gamble: twelve souls, or ten owed"

msgid "CARD_EVENT_COVENANT_DESC"
msgstr "a safe passage: five souls, a small blessing"

msgid "CARD_EVENT_LEDGER_DESC"
msgstr "strike five debts — for four souls now"

msgid "CARD_EVENT_MIRROR_DESC"
msgstr "your luck, flipped to its opposite"

msgid "CARD_EVENT_SIN"
msgstr "The Sin"

msgid "CARD_EVENT_SIN_DESC"
msgstr "a boss sits the next table — walk around and he marks it"

msgid "EV_SIN"
msgstr "He drags a throne to the felt —"

msgid "SIN_NAMES"
msgstr "PRIDE,GREED,LUST,ENVY,GLUTTONY,WRATH,SLOTH"

msgid "SIN_BEATEN"
msgstr "— the sin is beaten"

msgid "SIN_GATE"
msgstr "SIN"

msgid "EV_BROKEN"
msgstr "The card you kept snaps the bargain —"

msgid "DOOR_CRUELTY"
msgstr "He taps a nail on the felt — you will pick the one that bites."

msgid "DOOR_CURIOSITY"
msgstr "He leans in — he wants to see which door hunger takes you through."

msgid "DOOR_ANGER"
msgstr "He is still counting what you took. Choose. Carefully."

msgid "DOOR_RESPECT"
msgstr "A slow nod — you have earned the right to a harder door."

msgid "DOOR_BOREDOM"
msgstr "He yawns behind his teeth — hurry. Doors are for the dithering."

msgid "EP_TABLES"
msgstr "tables"

msgid "EP_DEPTH"
msgstr "depth"

msgid "CARD_EVENT_FURNACE"
msgstr "The Furnace"

msgid "CARD_EVENT_FURNACE_DESC"
msgstr "melts two of your spoils into one fused thing"

msgid "EV_FURNACE"
msgstr "The Furnace roars — two souls go in, one abomination crawls out."

msgid "EV_FURNACE_COLD"
msgstr "Nothing to melt — it warms your purse instead (+3 souls)."

msgid "CARD_FUSED_ABOMINATION"
msgstr "Fused Abomination"

msgid "CARD_EVENT_TAXIDERMIST"
msgstr "The Taxidermist"

msgid "CARD_EVENT_TAXIDERMIST_DESC"
msgstr "stitches a spare seal onto your newest spoil"

msgid "EV_TAXI"
msgstr "Needle and thread — your newest soul wakes with a seal:"

msgid "EV_TAXI_FULL"
msgstr "Already stuffed — he pays you for the visit (+3 souls)."

msgid "EV_TAXI_EMPTY"
msgstr "Nothing on your table worth stuffing (+3 souls)."

msgid "SIGIL_VENOM"
msgstr "Venom"

msgid "SIGIL_HAUNT"
msgstr "Haunt"

msgid "SIGIL_MIMIC"
msgstr "Mimic"

msgid "SIGIL_PIERCE"
msgstr "Pierce"

msgid "SIGIL_REVIVAL"
msgstr "Revival"

msgid "SIGIL_EXECUTIONER"
msgstr "Executioner"

msgid "SIGIL_BROOD"
msgstr "Brood"

msgid "SIGIL_TITHE"
msgstr "Tithe"

msgid "CARD_EVENT_PACT"
msgstr "The Pact"

msgid "CARD_EVENT_PACT_DESC"
msgstr "eight souls of debt — his tells shout at the next table"

msgid "EV_PACT"
msgstr "Signed in owed souls — next table, his hands cannot hold still."

msgid "ANGER_STEAL"
msgstr "He reaches across — a card burns straight out of your hand."

msgid "SIN_RULE_0"
msgstr "Pride seats a fortune it refuses to guard."
msgid "SIN_RULE_1"
msgstr "Greed weighs the tithe — every hand costs 3 more."
msgid "SIN_RULE_2"
msgstr "Lust courts your cards — your hand holds 4, not 6."
msgid "SIN_RULE_3"
msgstr "Envy chokes your grafts — stitched seals lie dormant."
msgid "SIN_RULE_4"
msgstr "Gluttony eats the pot — 2 chips a round, to him."
msgid "SIN_RULE_5"
msgstr "Wrath sharpens his whole line — and seats one pawn deeper."
msgid "SIN_RULE_6"
msgstr "Sloth plays one card a turn — but sits on a fat pile."

msgid "CARD_EVENT_CONFESSOR"
msgstr "The Confessional"

msgid "CARD_EVENT_CONFESSOR_DESC"
msgstr "kneel — three souls of debt forgiven, but he reads you deeper"

msgid "EV_CONFESS"
msgstr "Absolved — three souls lighter, and he knows you better than before."

msgid "CARD_EVENT_TOLL"
msgstr "The Tollgate"

msgid "CARD_EVENT_TOLL_DESC"
msgstr "four souls owed — the next table asks no depth-tax of you"

msgid "EV_TOLL"
msgstr "Paid on the nail — the next table holds its tithe."

msgid "CARD_EVENT_RELIQUARY"
msgstr "The Reliquary"

msgid "CARD_EVENT_RELIQUARY_DESC"
msgstr "a forgotten soul in its niche — it joins you freely"

msgid "EV_RELIC"
msgstr "The niche opens — a soul steps out and takes your side:"

msgid "CARD_HANGMAN"
msgstr "The Hangman"

msgid "CARD_HANGMAN_DESC"
msgstr "2/4 · his rope already knows your name — executioner's strike"

msgid "CARD_PENITENT"
msgstr "The Penitent"

msgid "CARD_PENITENT_DESC"
msgstr "0/4 · each blow he takes pays a chip into the pot"

msgid "AZRAIL_CRUELTY_2"
msgstr "Azrail savors it. \"You bleed beautifully — do it again.\""

msgid "AZRAIL_CURIOSITY_2"
msgstr "Azrail studies you. \"Every move of yours is a page I've already read.\""

msgid "AZRAIL_ANGER_2"
msgstr "Azrail rises half out of his seat. \"The table turns against you now.\""

msgid "AZRAIL_RESPECT_2"
msgstr "Azrail pours himself a measure. \"I will hate to lose you. Almost.\""

msgid "AZRAIL_BOREDOM_2"
msgstr "Azrail counts the ceiling cracks aloud. \"Entertain me, debtor.\""

msgid "TRICK_HIS"
msgstr "Azrail slides %s from his sleeve."

msgid "CARD_HALBERD"
msgstr "The Halberdier"

msgid "CARD_HALBERD_DESC"
msgstr "1/2 · his point clears the wall — strikes the back rank"

msgid "SIGIL_REACH"
msgstr "Reach — strikes over the wall into the back rank"

msgid "SIGIL_SHARP"
msgstr "Sharp — strikes first; a kill earns no answer"

msgid "SIGIL_LOAN_SHARK"
msgstr "Loan Shark — each wound it takes pays a chip"

msgid "SIGIL_SWAP"
msgstr "Swap — on reveal it slips to a free lane"

msgid "HINT_BACKROW"
msgstr "Back rank: sheltered support — it can't strike, and it can't be struck while its lane's front stands."

msgid "CARD_DEACON"
msgstr "The Deacon"

msgid "CARD_DEACON_DESC"
msgstr "0/3 · each round he blesses his lane's striker: +1 attack"

msgid "CARD_GRAVEDIGGER"
msgstr "The Gravedigger"

msgid "CARD_GRAVEDIGGER_DESC"
msgstr "1/2 · every friendly corpse in his lane sharpens him: +1 attack"

msgid "SIGIL_WAXHIDE"
msgstr "Waxhide — ignores the first wound each round"

msgid "SIGIL_SHELL"
msgstr "Shell — sacrificing it yields +1 extra blood"

msgid "SIGIL_VEIL"
msgstr "Veil — cannot be Called as a bluff"

msgid "SIGIL_ANCHOR"
msgstr "Anchor — cannot be moved or swapped"

msgid "SIGIL_POT_CUT"
msgstr "Pot Cut — on reveal, skims a chip per five in the pot"

msgid "HINT_VEIL"
msgstr "That one is veiled — it cannot be Called."

msgid "HINT_ANCHOR"
msgstr "Anchored — this card cannot move."

msgid "SIGIL_FRENZIED"
msgstr "Frenzied — a kill buys a second strike at −2 attack"

msgid "SIGIL_BULWARK"
msgstr "Bulwark — once attacked, it cannot be answered"

msgid "SIGIL_EYECORNER"
msgstr "Eyecorner — on reveal, glimpse an enemy concealed card"

msgid "HINT_EYECORNER"
msgstr "You glimpse what lies hidden"

msgid "HINT_EYECORNER_HIS"
msgstr "He glimpses one of your cards — a learned read."

msgid "CARD_OWED_PIG"
msgstr "Owed Pig"

msgid "CARD_OWED_PIG_DESC"
msgstr "A 4/4 wall — but it feeds your debt +3 the moment it lands"

msgid "CARD_CHOIR_LEECH"
msgstr "Choir Leech"

msgid "CARD_CHOIR_LEECH_DESC"
msgstr "Sips one chip back to your pile every time it clashes"

msgid "CARD_EYES_SERVANT"
msgstr "Eyes' Servant"

msgid "CARD_EYES_SERVANT_DESC"
msgstr "Eyecorner — on reveal, glimpse an enemy concealed card"

msgid "CARD_MIRROR_HOUND"
msgstr "Mirror Hound"

msgid "CARD_MIRROR_HOUND_DESC"
msgstr "Mimic — on reveal, wears the opposing card's stats and seals"

msgid "HINT_OWED_PIG"
msgstr "The pig feeds the ledger — debt +3."

msgid "SIGIL_PROTECTION"
msgstr "Protection — enemy tricks cannot touch it"

msgid "CARD_BLUFFER"
msgstr "The Bluffer"

msgid "CARD_BLUFFER_DESC"
msgstr "Nothing on the felt — but if an enemy read sees it, it bursts and the reader pays 2 chips"

msgid "CARD_HOT_IRON_T"
msgstr "Hot Iron"

msgid "HINT_IRON_WARDED"
msgstr "The iron finds nothing it can sear — his trick returns unspent."

msgid "HINT_BLUFFER_CAUGHT"
msgstr "Caught looking — the Bluffer bursts and he pays 2 chips for the read."

msgid "RULE_CANDLE_WATCH"
msgstr "Candle Watch — no sacrifices"

msgid "RULE_OPEN_TABLE"
msgstr "Open Table — all cards face-up"

msgid "RULE_PASSAGE_TOLL"
msgstr "Passage Toll — every draw costs 1 chip"

msgid "RULE_SABBATH"
msgstr "Sabbath — the mantel is silent"

msgid "RULE_HIGH_STAKES"
msgstr "High Stakes — blinds ×2, pot pays ×2"

msgid "RULE_BLOOD_PRICE"
msgstr "Blood Price — your deck enters wounded"

msgid "HINT_RULE_CANDLE"
msgstr "Candle Watch — no blood may be drawn at this table."

msgid "CARD_EVENT_PIT"
msgstr "The Pit"

msgid "CARD_EVENT_PIT_DESC"
msgstr "His table — rules dropped, your trumps mirrored back. Fight."

msgid "EV_PIT"
msgstr "The Pit. He drops the rules and cheats where you can see it. The next table is his."

msgid "EV_PIT_TABLE"
msgstr "The Pit — his table. Ante +4. Your trumps will be mirrored at you."

msgid "PIT_CHEAT"
msgstr "He doesn't even look — every concealed card you hold turns face-up. The rules are gone."

msgid "TRUMP_MIRRORED_PIT"
msgstr "Mirrored — the same cheat turns on you."

msgid "CARD_BARGAINER"
msgstr "Dark Bargainer"

msgid "CARD_BARGAINER_DESC"
msgstr "1/3 · every chip he earns is written as debt"

msgid "CARD_MIST_PAGE"
msgstr "Mist Page"

msgid "CARD_MIST_PAGE_DESC"
msgstr "0/2 · a fog courier — slides its own lane free"

msgid "CARD_DISSECTOR"
msgstr "The Dissector"

msgid "CARD_DISSECTOR_DESC"
msgstr "2/2 · strikes first — the cut comes before the answer"

msgid "CARD_THURIFER"
msgstr "The Thurifer"

msgid "CARD_THURIFER_DESC"
msgstr "0/4 · a smoke wall — its killer inherits the curse"

msgid "CARD_SALT_CIRCLE"
msgstr "Salt Circle"

msgid "CARD_SALT_CIRCLE_DESC"
msgstr "trick · wards a pawn — grafts Protection onto it"

msgid "CARD_GRAVE_CANDLE"
msgstr "Grave Candle"

msgid "CARD_GRAVE_CANDLE_DESC"
msgstr "trick · knits 2 wounds, burns the venom out"

msgid "TRICK_SALT"
msgstr "Salt seals the circle — %s is warded"

msgid "TRICK_CANDLE"
msgstr "The grave candle gutters — %s's wounds knit"

msgid "CARD_BONDSMAN"
msgstr "The Bondsman"

msgid "CARD_BONDSMAN_DESC"
msgstr "0/3 · rooted where he kneels — skims the pot"

msgid "CARD_ALMS_SISTER"
msgstr "Alms Sister"

msgid "CARD_ALMS_SISTER_DESC"
msgstr "0/3 · her bowl pays two chips — offers thick"

msgid "AZRAIL_BLUFF_CAUGHT"
msgstr "You saw the lie. Not the first to — but the loudest."

msgid "AZRAIL_MULLIGAN"
msgstr "Didn't like the hand. I dealt it — remember that."

msgid "AZRAIL_OWED_PIG"
msgstr "Recognize the pig? Your debt wears that face."

msgid "AZRAIL_WAGER_YES"
msgstr "That's my player. Bleed a little more for me."

msgid "AZRAIL_SOULDRAW"
msgstr "Your deck ran dry. Now we count the cards in your blood."

msgid "AZRAIL_BIG_POT"
msgstr "A fine pile. Fine until somebody takes it."

msgid "HINT_SOULDRAW"
msgstr "Deck empty — each draw bleeds 2 chips into the pot"

msgid "AZRAIL_C_REAPER"
msgstr "A reaper at my own table. I like your nerve."

msgid "AZRAIL_C_PRIESTESS"
msgstr "The High Priestess. She still owes me a coin."

msgid "AZRAIL_C_USURER"
msgstr "My own usurer, seated against me. Bold."

msgid "AZRAIL_C_MARTYR"
msgstr "Another martyr. They never learn."

msgid "AZRAIL_C_HOUND"
msgstr "The hound mirrors. Careful what it catches."

msgid "AZRAIL_C_BLUFFER"
msgstr "You keep liars in your deck as well. Good."

msgid "CARD_COLD_IRON"
msgstr "Cold Iron"

msgid "CARD_COLD_IRON_DESC"
msgstr "Touch one of his cards. Lies burn; truths turn face-up."

msgid "CARD_ASH_OFFERING"
msgstr "Ash Offering"

msgid "CARD_ASH_OFFERING_DESC"
msgstr "Burn one of your pawns at the stake: +3 chips, +2 blood."

msgid "TRICK_IRON"
msgstr "Cold iron turns the card — it was real."

msgid "TRICK_IRON_BLUFF"
msgstr "Cold iron finds the counterfeit and burns it. He pays 2."

msgid "TRICK_ASH"
msgstr "%s feeds the fire — the pot smells of meat."

msgid "CARD_GRAVEWORM"
msgstr "Graveworm"

msgid "CARD_GRAVEWORM_DESC"
msgstr "A cheap writhing striker — venom on the tooth, frenzy in the coil."

msgid "CARD_NIGHT_COLLECTOR"
msgstr "Night Collector"

msgid "CARD_NIGHT_COLLECTOR_DESC"
msgstr "Plated and patient; every chip he touches is written down as debt."

msgid "CARD_WEEPING_IDOL"
msgstr "Weeping Idol"

msgid "CARD_WEEPING_IDOL_DESC"
msgstr "A stone saint that weeps real alms — a wall that pays."

msgid "CARD_DUST_SCRIBE"
msgstr "Dust Scribe"

msgid "CARD_DUST_SCRIBE_DESC"
msgstr "Sees around its own wall and reaches the sheltered rank behind."

msgid "AZRAIL_R_BLED"
msgstr "That much blood in one hand. I felt it from here."

msgid "AZRAIL_R_STRUCK"
msgstr "You struck deep. I had not thought you had it in you."

msgid "AZRAIL_SACRIFICE"
msgstr "Feeding me your own souls now. Keep going."

msgid "CARD_PALLBEARER"
msgstr "Pallbearer"

msgid "CARD_PALLBEARER_DESC"
msgstr "Slow and certain — what it kills stays killed."

msgid "CARD_DROWNED_BELLMAN"
msgstr "Drowned Bellman"

msgid "CARD_DROWNED_BELLMAN_DESC"
msgstr "Comes back wet; rings once for the pot when seated."

msgid "CARD_STRONGBOX"
msgstr "Strongbox"

msgid "CARD_STRONGBOX_DESC"
msgstr "A safe that walks — skims into the pot; wax seals the first wound."

msgid "CARD_MOTH_ORACLE"
msgstr "Moth Oracle"

msgid "CARD_MOTH_ORACLE_DESC"
msgstr "Flits lanes on dusty wings; veiled against being read."

msgid "AZRAIL_DOOR_WHISPER"
msgstr "The whispers charge double what they sell."

msgid "AZRAIL_DOOR_WHEEL"
msgstr "The wheel owes me too. It never pays."

msgid "AZRAIL_DOOR_COVENANT"
msgstr "A bargain with me under the table. Shrewd."

msgid "AZRAIL_DOOR_LEDGER"
msgstr "Numbers are honest. That is why I keep a usurer."

msgid "AZRAIL_DOOR_MIRROR"
msgstr "I own that mirror. Whatever you saw was mine first."

msgid "AZRAIL_DOOR_FURNACE"
msgstr "Feed it well — it always asks for seconds."

msgid "AZRAIL_DOOR_TAXIDERMIST"
msgstr "He stuffs the dead with leftovers. Appetizing."

msgid "AZRAIL_DOOR_PACT"
msgstr "Debt buys eyesight. Yours costs more than mine."

msgid "AZRAIL_DOOR_CONFESSOR"
msgstr "Kneelers tell me more than talkers."

msgid "AZRAIL_DOOR_TOLL"
msgstr "Paying ahead. The house loves a planner."

msgid "AZRAIL_DOOR_RELIQUARY"
msgstr "A free soul. Nothing here is free — least of all that."

msgid "AZRAIL_DOOR_PIT"
msgstr "My table. My rules. You sat anyway."

msgid "AZRAIL_DOOR_SIN"
msgstr "You knocked. They always answer."
